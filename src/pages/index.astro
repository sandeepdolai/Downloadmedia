---
import '../styles/global.css';

const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const assetBase = `${basePath}/assets/`;
const brandLogo = `${assetBase}brand-mark-high.png`;
const playOrb = `${assetBase}o_play.png`;
const globeOrb = `${assetBase}o_globe.png`;
const showcaseImage = `${assetBase}showcase-composition.png`;
const studioCardImage = `${assetBase}studio_card_full_master.jpg`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content="MemorableDay.in — download anything." />
    <title>MemorableDay.in — Download Anything</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800&family=Poppins:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header" id="home">
      <a class="brand" href="#home" aria-label="MemorableDay.in home">
        <img class="brand-mark" src={brandLogo} alt="" />
        <span>MemorableDay.in</span>
      </a>

      <nav class="main-nav" aria-label="Main navigation">
        <a href="#home">Home</a>
        <a href="#supported-sites">Supported Sites</a>
        <a href="#features">Features</a>
        <a href="#faq">FAQ</a>
      </nav>

      <a class="account-button" href="#create-account">Create Account</a>
    </header>

    <main class="hero" id="create-account">
      <h1 class="hero-title" aria-label="Download Anything">
        <span class="title-line title-line-one" aria-hidden="true">
          <span class="letter-group">D</span>
          <img class="title-orb play-orb" src={playOrb} alt="" />
          <span class="letter-group">WNL</span>
          <img class="title-orb globe-orb" src={globeOrb} alt="" />
          <span class="letter-group">AD</span>
        </span>
        <span class="title-line title-line-two" aria-hidden="true">ANYTHING</span>
      </h1>

      <form class="download-bar" id="download-form" autocomplete="off" data-api-base="/api">
        <label class="visually-hidden" for="media-url">Media link</label>
        <input
          id="media-url"
          name="url"
          type="url"
          placeholder="Paste your media link here..."
          inputmode="url"
        />
        <button class="download-button" type="submit">
          <span>Download Now</span>
          <span class="button-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path
                d="M8.4 5.9c-.55-.34-1.25.05-1.25.7v10.8c0 .65.7 1.04 1.25.7l8.7-5.4a.82.82 0 0 0 0-1.4l-8.7-5.4Z"
                fill="currentColor"
              />
            </svg>
          </span>
        </button>
      </form>

      <div class="auth-cookie-control">
        <label for="media-cookies">Optional: Use your own account session</label>
        <input id="media-cookies" type="file" accept=".txt,text/plain" />
        <p>Upload a Netscape-format cookies.txt only when the source requires your sign-in. Cookies are sensitive and are sent to MemorableDay's download server for this request; use a site-specific export, never share the file, and never upload someone else's session.</p>
      </div>

      <p class="form-feedback" id="form-feedback" role="status" aria-live="polite"></p>

      <section class="download-results" id="download-results" aria-live="polite" hidden>
        <div class="download-result-heading">
          <strong id="download-result-title">Media ready</strong>
          <span id="download-result-meta"></span>
        </div>
        <div class="download-result-controls">
          <label for="download-format">Format</label>
          <select id="download-format" name="format"></select>
          <button class="download-button download-result-button" id="download-selected" type="button">
            <span>Download</span>
            <span class="button-play" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="M8.4 5.9c-.55-.34-1.25.05-1.25.7v10.8c0 .65.7 1.04 1.25.7l8.7-5.4a.82.82 0 0 0 0-1.4l-8.7-5.4Z" fill="currentColor" />
              </svg>
            </span>
          </button>
        </div>
      </section>
    </main>

    <section class="feature-showcase" aria-label="4K video, MP3 audio, no watermark and instant save">
      <img
        class="showcase-image"
        src={showcaseImage}
        alt=""
        decoding="async"
        fetchpriority="high"
      />
    </section>


    <section class="platform-trust" id="supported-sites" aria-labelledby="platform-trust-title">
      <div class="platform-trust-inner">
        <h2 class="platform-trust-title" id="platform-trust-title">Supported Platforms:</h2>
        <div class="platform-stats" aria-label="Usage statistics">
          <div class="platform-stat"><strong>10M+</strong><span>Downloads</span></div>
          <div class="platform-stat"><strong>99.9%</strong><span>Success</span></div>
          <div class="platform-stat"><strong>500K+</strong><span>Daily Users</span></div>
        </div>
        <div class="platform-list" aria-label="Supported platforms">
          <div class="platform-item"><img class="platform-icon youtube-icon" src={`${assetBase}flat_youtube.png`} alt="" /><span>YouTube</span></div>
          <div class="platform-item"><img class="platform-icon" src={`${assetBase}flat_instagram.png`} alt="" /><span>Instagram</span></div>
          <div class="platform-item"><img class="platform-icon" src={`${assetBase}flat_tiktok.png`} alt="" /><span>TikTok</span></div>
          <div class="platform-item"><img class="platform-icon" src={`${assetBase}flat_facebook.png`} alt="" /><span>Facebook</span></div>
          <div class="platform-item"><img class="platform-icon" src={`${assetBase}flat_pinterest.png`} alt="" /><span>Pinterest</span></div>
        </div>
        <div class="platform-proof">
          <div class="avatars-trio-frame">
            <img class="avatars-trio" src={`${assetBase}avatars_trio.png`} alt="People in the MemorableDay community" loading="lazy" decoding="async" />
          </div>
          <div class="platform-proof-copy">
            <h3>Trusted by millions<br />worldwide</h3>
            <p>Fast, free, and secure media<br class="desktop-break" /> downloads</p>
          </div>
        </div>
      </div>
    </section>


    <section class="studio-feature" id="studio-feature" aria-labelledby="studio-feature-title">
      <div class="studio-feature-inner">
        <h2 class="studio-feature-title" id="studio-feature-title">
          <span>Unlimited</span>
          <span>Downloads for All</span>
        </h2>
        <div class="studio-feature-content">
          <div class="studio-feature-art">
            <img
              src={studioCardImage}
              alt="MemorableDay.in Studio card with a liquid chrome sculpture and MP4, MP3, and TikTok badges"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="studio-feature-copy">
            <p class="studio-feature-kicker">MemorableDay.in Studio</p>
            <h3>Explore Fast<br />&amp; Free Media<br />Saving</h3>
            <p class="studio-feature-description">
              Easy downloads for 4K videos and 320kbps MP3 audio without watermarks.
            </p>
            <a class="studio-feature-cta" href="#create-account">
              <span>Try Downloader</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="studio-feature-cards" id="features" aria-label="Downloader features">
      <article class="studio-mini-card">
        <h3>One-Click<br />Paste</h3>
        <svg class="studio-card-arrow studio-card-arrow-top" viewBox="0 0 28 28" aria-hidden="true">
          <path d="M5 23 23 5M8 5h15v15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" stroke-linejoin="miter" />
        </svg>
        <div class="paste-link-pill">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9.8 14.2 8.1 15.9a3.5 3.5 0 0 1-5-5l4-4a3.5 3.5 0 0 1 5 0M14.2 9.8l1.7-1.7a3.5 3.5 0 0 1 5 5l-4 4a3.5 3.5 0 0 1-5 0M8.4 15.6l7.2-7.2" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>Link</span>
        </div>
      </article>

      <article class="studio-mini-card">
        <h3>MP4 &amp; MP3<br />Quality Selector</h3>
        <svg class="studio-card-arrow studio-card-arrow-top" viewBox="0 0 28 28" aria-hidden="true">
          <path d="M5 23 23 5M8 5h15v15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" stroke-linejoin="miter" />
        </svg>
        <div class="quality-chip-grid" aria-label="Available quality options">
          <span>4K HD</span>
          <span class="quality-chip-selected">1080p</span>
          <span>720p</span>
          <span class="quality-chip-custom">Custom Resolution</span>
          <span class="quality-chip-more">•••</span>
        </div>
      </article>

      <article class="studio-mini-card studio-no-watermark-card">
        <h3>No Watermarks<br />Ever</h3>
        <img class="no-watermark-art" src={assetBase + "no_watermark_icon.png"} alt="" loading="lazy" decoding="async" />
        <svg class="studio-card-arrow studio-card-arrow-bottom" viewBox="0 0 28 28" aria-hidden="true">
          <path d="M5 5 23 23M8 23h15V8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" stroke-linejoin="miter" />
        </svg>
      </article>
    </section>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <a class="footer-brand" href="#home" aria-label="MemorableDay.in home">
          <img src={brandLogo} alt="" />
          <span>MemorableDay.in</span>
        </a>
        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="#privacy-policy">Privacy Policy</a>
          <a href="#terms-of-service">Terms of Service</a>
          <a href="#contact-us">Contact Us</a>
        </nav>
      </div>
    </footer>

    <script>
      import '../scripts/download.js';
    </script>
  </body>
</html>