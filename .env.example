# URL of the universal multi-site downloader engine (Python/FastAPI service).
# The Vercel api/v1 gateway functions forward extractor-site links, generic
# webpages and HLS/DASH manifests here. Direct HTTPS media files are served
# by the gateway itself without touching the engine.
DOWNLOADER_API_URL=https://memorableday-downloader-api.onrender.com

# Local development overrides for the Python engine (server/ directory).
PORT=10000
MAX_DOWNLOAD_MB=300
ALLOWED_ORIGINS=https://memorableday.in,https://www.memorableday.in,https://memorableday-in.vercel.app,http://localhost:4321

# Dev-only escape hatch so the engine can reach local test servers.
# NEVER enable in production.
# ALLOW_PRIVATE_TARGETS=true
