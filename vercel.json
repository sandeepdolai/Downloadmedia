{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/v1/inspect.js": {
      "maxDuration": 90
    },
    "api/v1/download.js": {
      "maxDuration": 300
    }
  },
  "regions": [
    "bom1"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://memorableday-downloader-api.onrender.com/:path*"
    }
  ]
}
